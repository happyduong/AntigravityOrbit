# Maintainer: Antigravity Orbit Authors <https://github.com/phucduong/AntigravityOrbit>
pkgname=antigravity-orbit-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="Google AI Quota Monitor & Smart Account Rotator for Antigravity IDE, agy CLI & Desktop App"
arch=('x86_64' 'aarch64')
url="https://github.com/phucduong/AntigravityOrbit"
license=('MIT')
depends=('libayatana-appindicator' 'libsecret' 'webkit2gtk-4.1')
provides=('antigravity-orbit')
conflicts=('antigravity-orbit')
source=("Antigravity-Orbit-${pkgver}-linux.tar.gz")
sha256sums=('SKIP')

package() {
    install -Dm755 "${srcdir}/antigravity-orbit" "${pkgdir}/usr/bin/antigravity-orbit"
    install -Dm644 "${srcdir}/antigravity-orbit.desktop" "${pkgdir}/usr/share/applications/antigravity-orbit.desktop"
    install -Dm644 "${srcdir}/antigravity-orbit.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/antigravity-orbit.png"
}

