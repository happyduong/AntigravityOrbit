<Page
    x:Class="AntigravityOrbit.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="500">
        <Image Source="ms-appx:///Assets/AppIcon1024.png" Width="90" Height="90" HorizontalAlignment="Center">
            <Image.Clip>
                <RectangleGeometry Rect="0,0,90,90" RadiusX="18" RadiusY="18" />
            </Image.Clip>
        </Image>

        <TextBlock Text="Antigravity Orbit" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Padding="8,3" CornerRadius="4" HorizontalAlignment="Center">
            <TextBlock Text="Windows 11 Edition • WinUI 3 Native" FontSize="11" FontWeight="SemiBold" Foreground="White" />
        </Border>

        <TextBlock Text="Ứng dụng mã nguồn mở tối ưu, tự động giám sát quota và xoay vòng tài khoản Google AI Pro / Ultra cho Antigravity IDE, agy CLI &amp; Desktop App trên hệ điều hành Windows 11."
                   TextWrapping="Wrap" TextAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" Margin="0,10,0,0">
            <HyperlinkButton Content="Tài liệu GitHub" NavigateUri="https://github.com/phucduong/AntigravityOrbit" />
            <TextBlock Text="•" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <TextBlock Text="Giấy phép MIT" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </StackPanel>
</Page>

