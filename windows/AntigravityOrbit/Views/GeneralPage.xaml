<Page
    x:Class="AntigravityOrbit.Views.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="20" MaxWidth="600" HorizontalAlignment="Left">
        <TextBlock Text="Cài đặt Hệ thống" FontWeight="SemiBold" FontSize="18" />

        <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="16">
                <!-- Language -->
                <Grid>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Ngôn ngữ giao diện" FontWeight="Medium" />
                        <TextBlock Text="Ngôn ngữ hiển thị trên ứng dụng và menu khay hệ thống" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageComboBox" HorizontalAlignment="Right" Width="140" SelectionChanged="ConfigControl_Changed">
                        <ComboBoxItem Content="Tiếng Việt" Tag="vi" IsSelected="True" />
                        <ComboBoxItem Content="English" Tag="en" />
                        <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                        <ComboBoxItem Content="日本語" Tag="ja" />
                    </ComboBox>
                </Grid>

                <MenuFlyoutSeparator />

                <!-- Autostart -->
                <Grid>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Khởi động cùng Windows 11" FontWeight="Medium" />
                        <TextBlock Text="Tự động chạy ngầm trên khay Taskbar khi đăng nhập Windows" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="AutostartToggle" HorizontalAlignment="Right" Toggled="ConfigControl_Changed" />
                </Grid>

                <MenuFlyoutSeparator />

                <!-- Notifications -->
                <Grid>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Thông báo màn hình (Toast)" FontWeight="Medium" />
                        <TextBlock Text="Gửi thông báo tới Windows Action Center khi xoay vòng hoặc đổi tài khoản" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="NotificationsToggle" HorizontalAlignment="Right" Toggled="ConfigControl_Changed" />
                </Grid>

                <MenuFlyoutSeparator />

                <!-- Sound -->
                <Grid>
                    <StackPanel Spacing="2">
                        <TextBlock Text="Âm thanh thông báo" FontWeight="Medium" />
                        <TextBlock Text="Phát âm thanh thông báo chuẩn của Windows 11 khi có sự kiện" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <ToggleSwitch x:Name="SoundToggle" HorizontalAlignment="Right" Toggled="ConfigControl_Changed" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>

