<Page
    x:Class="AntigravityOrbit.Views.AccountsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:AntigravityOrbit.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ImportIdeButton" Style="{ThemeResource AccentButtonStyle}" Click="ImportIdeButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE734;" FontSize="14" />
                        <TextBlock Text="Import từ IDE" />
                    </StackPanel>
                </Button>

                <Button x:Name="GoogleLoginButton" Click="GoogleLoginButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                        <TextBlock Text="Đăng nhập Google" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button Grid.Column="1" x:Name="RefreshButton" Click="RefreshButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    <TextBlock Text="Làm mới" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Accounts List -->
        <ScrollViewer Grid.Row="1">
            <ItemsControl x:Name="AccountsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:AccountStatus">
                        <Border Margin="0,0,0,12" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Spacing="6">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Email}" FontWeight="SemiBold" FontSize="14" />
                                            <Border Padding="6,2" CornerRadius="4" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}">
                                                <TextBlock Text="{x:Bind DisplayTierName}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{x:Bind DisplayModelName}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Button Content="Kích hoạt" Tag="{x:Bind Id}" Click="SwitchButton_Click" IsEnabled="{x:Bind IsCurrent, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" />
                                        <Button Content="Xóa" Tag="{x:Bind Id}" Click="DeleteButton_Click" IsEnabled="{x:Bind IsCurrent, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Quota Progress Bars -->
                                <Grid Grid.Row="1" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 5h Quota -->
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="Hạn mức 5 giờ" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind RemainingPercentage, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind RemainingPercentage, Mode=OneWay}" Maximum="100" Height="6" />
                                    </StackPanel>

                                    <!-- Weekly Quota -->
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <Grid>
                                            <TextBlock Text="Hạn mức tuần" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{x:Bind GeminiWeeklyPercentage, Mode=OneWay}" HorizontalAlignment="Right" FontSize="11" FontWeight="SemiBold" />
                                        </Grid>
                                        <ProgressBar Value="{x:Bind GeminiWeeklyPercentage, Mode=OneWay}" Maximum="100" Height="6" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>

